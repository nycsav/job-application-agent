+// Shared dedup key for the Career Command Center.
+// Must match lib/dedup.mjs in job-application-agent so BOTH writers dedupe alike.
+const STOP = /\b(the|a|an|of|and|inc|llc|ltd|corp|co|group)\b/g;
+
+export function normalize(s = ""): string {
+  return String(s)
+    .toLowerCase()
+    .replace(/[‘’“”]/g, "'")
+    .replace(/&/g, " and ")
+    .replace(/[^a-z0-9 ]+/g, " ")
+    .replace(STOP, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export function dedupeKey(company = "", title = ""): string {
+  return `${normalize(company)}|${normalize(title)}`;
+}
+
+export function urlKey(jobUrl = ""): string {
+  const u = String(jobUrl);
+  const m =
+    u.match(/greenhouse\.io\/[^/]+\/jobs\/(\d+)/i) ||
+    u.match(/lever\.co\/[^/]+\/([0-9a-f-]{36})/i) ||
+    u.match(/linkedin\.com\/jobs\/view\/(\d+)/i) ||
+    u.match(/jobs?\/(\d{6,})/i);
+  return m ? m[1].toLowerCase() : "";
+}
