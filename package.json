{
  "name": "job-engine",
  "version": "1.0.0",
  "description": "Automated job application engine — Scanner → Materials → Submitter",
  "type": "module",
  "scripts": {
    "scan": "node agents/scanner.mjs",
    "generate": "node agents/materials.mjs",
    "submit": "node agents/submitter.mjs",
    "pipeline": "node orchestrator.mjs",
    "test": "node lib/test-templates.mjs",
    "scan:personal": "node agents/personal-gmail-scanner.mjs",
    "scan:personal:24h": "node agents/personal-gmail-scanner.mjs --hours 24",
    "gmail:setup": "node lib/gmail-auth.mjs",
    "daemon:login": "node daemon/easy-apply-bot.mjs --login",
    "daemon:apply": "node daemon/easy-apply-bot.mjs --apply",
    "daemon:run": "node daemon/run-once.mjs",
    "daemon:run:dry": "node daemon/run-once.mjs --dry-run",
    "daemon:relay:scan": "node daemon/relay-client.mjs scan",
    "daemon:relay:read": "node daemon/relay-client.mjs read",
    "daemon:install": "cp daemon/launchd/com.sav.job-apply-daemon.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.sav.job-apply-daemon.plist",
    "daemon:uninstall": "launchctl unload ~/Library/LaunchAgents/com.sav.job-apply-daemon.plist && rm ~/Library/LaunchAgents/com.sav.job-apply-daemon.plist",
    "daemon:status": "launchctl list | grep com.sav.job-apply-daemon",
    "submit-ready": "node daemon/submit-ready.mjs",
    "submit-ready:dry": "node daemon/submit-ready.mjs --dry-run",
    "submit-ready:dry-mock": "node daemon/submit-ready.mjs --dry-run --mock",
    "submit-ready:enable": "mkdir -p .secrets && touch .secrets/submitter.allow && echo 'AUTHORIZED: this machine is now the live submitter (.secrets/submitter.allow created). Run ONLY on the Mac Mini.'",
    "submit-ready:disable": "rm -f .secrets/submitter.allow && echo 'DISABLED: live submit off on this machine — runs are forced to dry-run.'",
    "submit-ready:install": "cp daemon/launchd/com.sav.job-auto-submit.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.sav.job-auto-submit.plist",
    "submit-ready:uninstall": "launchctl unload ~/Library/LaunchAgents/com.sav.job-auto-submit.plist && rm ~/Library/LaunchAgents/com.sav.job-auto-submit.plist",
    "submit-ready:status": "launchctl list | grep com.sav.job-auto-submit"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "googleapis": "^144.0.0",
    "playwright": "^1.48.0"
  }
}
